{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NodePulse IDE",
  "version": "0.1.2",
  "identifier": "id.ussi.nodepulse-devkit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NodePulse IDE",
        "width": 640,
        "height": 520,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/aurigalugina/nodepulse-devkit-releases/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDNTQ0RDBBNDRBMzRDQjAKUldTd1RLTkVDazFVN0hLNy9rQ1hXd1JTRFZralBKY1R0NGpCMjgyL0NuaEZMTVFsL3B1d1A0SWcK"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["nodepulse-ide"]
      }
    }
  }
}
