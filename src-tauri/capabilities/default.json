  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for NodePulse IDE",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
